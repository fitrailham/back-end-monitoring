DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=icongreen_monitoring
DB_USER=icongreen_monitor_dev
DB_PASSWORD=replace_me

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
# Set production + HTTPS cookies when deploying. SameSite=none requires Secure.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Absolute session lifetime (8 hours); login windows are shared across API workers.
AUTH_SESSION_SECONDS=28800
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
STALE_AFTER_MINUTES=15

# Sesuaikan server dengan region akun Northbound.
FUSIONSOLAR_BASE_URL=https://sg5.fusionsolar.huawei.com
FUSIONSOLAR_USERNAME=replace_with_northbound_username
FUSIONSOLAR_PASSWORD="replace_with_northbound_password"
FUSIONSOLAR_STATIONS_PATH=getStationList
FUSIONSOLAR_ALARMS_PATH=
FUSIONSOLAR_ALARM_LANGUAGE=en_US
FUSIONSOLAR_ALARM_LOOKBACK_HOURS=24
# Aktifkan setelah getDevRealKpi telah diizinkan untuk akun Northbound.
FUSIONSOLAR_DEVICE_REALTIME_ENABLED=false
FUSIONSOLAR_DEVICE_REALTIME_TYPE_IDS=1,17,39,41,47
# Ubah hanya jika tanda daya sumber sudah diverifikasi sesuai kontrak berikut.
FUSIONSOLAR_POWER_DIRECTION_CONVENTION=unverified
INVENTORY_SYNC_INTERVAL_HOURS=24
INVENTORY_STALE_AFTER_SECONDS=93600
FUSIONSOLAR_ENABLED=false
SYNC_INTERVAL_MINUTES=10
# pretty_json = JSON berindentasi untuk terminal; json = satu objek per baris.
LOG_FORMAT=pretty_json
LOG_LEVEL=INFO
LOG_TIME_ZONE=Asia/Jakarta
# Cooldown lokal setelah failCode=407; minimum 600 detik, bukan jaminan reset kuota server.
FUSIONSOLAR_QUOTA_COOLDOWN_SECONDS=600

# Override tipe perangkat hanya sesuai referensi NBI versi server Anda (JSON object).
FUSIONSOLAR_DEVICE_TYPE_MAP={}
